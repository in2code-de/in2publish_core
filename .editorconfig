root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.css]
indent_style = tab
indent_size = 4

[*.html]
indent_style = tab
indent_size = 4

[*.scss]
indent_style = space
indent_size = 2

[*.js]
indent_style = tab
indent_size = 4

[*.json]
indent_style = tab
indent_size = 4

[*.php]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4

[{*.yaml, *.yml, package.json}]
indent_style = space
indent_size = 2

[grumphp.yml]
indent_size = 4

[*.t3s]
indent_style = space
indent_size = 2

[*.xlf]
indent_style = tab
indent_size = 4

[*.xml.dist]
indent_style = tab
indent_size = 4
ij_continuation_indent_size = 8

[*.sql]
indent_style = space
indent_size = 4

# Database dump CSVs are generated by `SELECT ... INTO OUTFILE` (co-stack/mysql-loader)
# and are tab-delimited with backslash-escaped values. Rows rely on exact trailing
# (empty) columns; trimming trailing whitespace drops columns and makes `LOAD DATA`
# fail on `make restore` ("Row doesn't contain data for all columns"). Never modify
# whitespace/newlines here — regenerate via `make dump-dbs` instead of editing by hand.
[.project/data/dumps/**/*.csv]
trim_trailing_whitespace = false
insert_final_newline = false

[.eslintrc]
indent_style = space
indent_size = 4

# https://docs.typo3.org/m/typo3/reference-coreapi/10.4/en-us/CodingGuidelines/CglTypoScript/Index.html
[{ext_typoscript_setup.txt, *.typoscript, setup.txt, constants.txt, setup.ts, constants.ts}]
indent_style = space
indent_size = 2

[*.neon]
indent_style = tab
indent_size = 4
